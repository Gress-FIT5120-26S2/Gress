# This file is documentation only. Copy it to the untracked server/.env.production
# only when a production host does not provide environment variables directly.
NODE_ENV=production
PORT=3001
SUPABASE_URL=https://your-production-project-ref.supabase.co
# Obtain this only from Supabase Dashboard > Project Settings > API > Secret keys.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Arthur: NarIyirm
# 中文：公开 key 只用于设备鉴权后的 Realtime 连接，不能替换成 Secret key。
# EN: The public key only establishes Realtime after device authentication and must never be replaced with the Secret key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional: override the team's deployed visual-recognition endpoint.
FOOD_RECOGNITION_API_URL=https://d12q94a0v4ih7q.cloudfront.net/predict
