# This file is documentation only. Copy it to the untracked server/.env.production
# only when a production host does not provide environment variables directly.
NODE_ENV=production
PORT=3001
SUPABASE_URL=https://your-production-project-ref.supabase.co
# Obtain this only from Supabase Dashboard > Project Settings > API > Secret keys.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Arthur: NarIyirm
# 中文：公开 key 只用于设备鉴权后的 Realtime 连接，不能替换成 Secret key。
# EN: The public key only establishes Realtime after device authentication and must never be replaced with the Secret key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional: override the team's deployed visual-recognition endpoint.
FOOD_RECOGNITION_API_URL=https://d12q94a0v4ih7q.cloudfront.net/predict

# Arthur: NarIyirm
# 中文：这些 AI 凭证只配置在生产 Express 主机，绝不能添加 EXPO_PUBLIC_ 前缀或打包进 App。
# EN: Configure these AI credentials only on the production Express host; never prefix them with EXPO_PUBLIC_ or bundle them into the app.
GEMINI_API_KEY=replace_with_google_ai_studio_key
GEMINI_PRESET_MODEL=gemini-3.5-flash-lite
CLOUDFLARE_ACCOUNT_ID=replace_with_cloudflare_account_id
CLOUDFLARE_AI_API_TOKEN=replace_with_workers_ai_api_token
CLOUDFLARE_ICON_MODEL=@cf/black-forest-labs/flux-1-schnell
