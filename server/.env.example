# Copy this file to .env.development for the test Supabase project.
# For a production server, use platform environment variables or a private .env.production file.
PORT=3001
SUPABASE_URL=https://your-test-project-ref.supabase.co
# Use the secret key from Supabase Dashboard > Project Settings > API > Secret keys.
# Legacy projects can use the service_role key instead.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Arthur: NarIyirm
# 中文：公开 key 只用于设备鉴权后的 Realtime 连接，不能替换成 Secret key。
# EN: The public key only establishes Realtime after device authentication and must never be replaced with the Secret key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# SUPABASE_SERVICE_ROLE_KEY=legacy-service-role-key
# Optional: override the team's deployed visual-recognition endpoint.
FOOD_RECOGNITION_API_URL=https://d12q94a0v4ih7q.cloudfront.net/predict
