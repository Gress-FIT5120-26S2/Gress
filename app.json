{
  "expo": {
    "name": "KitchMemo",
    "slug": "kitchmemo",
    "description": "Keep your kitchen fresh, organised, and memorable.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/kitchmemo-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.gressfit5120.kitchmemo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true
    },
    "android": {
      "package": "com.gressfit5120.kitchmemo",
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/kitchmemo-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f23fe306-086e-4865-80b1-865c99f43862"
      }
    },
    "owner": "gress-fit5120-26s2",
    "plugins": [
      "expo-font",
      [
        "expo-asset",
        {
          "assets": [
            "./models/Kitchen-Home-rebuilt-lighting.glb"
          ]
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 KitchMemo 从相册选择食材照片用于识别 / Allow KitchMemo to choose ingredient photos from your library for recognition."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许 KitchMemo 使用相机识别食材和扫描条码 / Allow KitchMemo to use the camera for food recognition and barcode scanning.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
