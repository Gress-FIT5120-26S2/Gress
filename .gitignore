# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
server/.env
.env.development
.env.production
server/.env.development
server/.env.production

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
.vercel

# Arthur: NarIyirm
# 中文：演示文稿、文档渲染和本地工具环境仅保存在仓库外，避免把生成产物提交到 GitHub。
# EN: Keep presentation, document-rendering, and local tool workspaces outside the repository.
/.codex-document-build/
/.codex-presentation-build/
/.ppt-master-env/
/output/
/projects/
/assets/presentation/
/Build/
/models/
/branding/

# Arthur: NarIyirm
# 中文：运行时 GLB 已统一放入 assets/models；此处只保留需要版本化的模型源文件。
# EN: Runtime GLBs live in assets/models; keep only versioned model sources here.
!/models/
/models/*
!/models/Spoonie-Character-v2.blend

# Arthur: NarIyirm
# 中文：成就奖牌的 Blender 源文件、移动端 GLB 与验证预览需要随代码版本化，确保模型可重建和跨环境打包。
# EN: Version achievement medal Blender sources, mobile GLBs, and verification previews so models remain reproducible and bundle across environments.
!/models/achievements/
!/models/achievements/**

# Arthur: NarIyirm
# 中文：说明与交接文档由 Git 跟踪；.easignore 单独控制它们不进入 App 构建上传。
# EN: Track documentation in Git; .easignore separately keeps it out of app build uploads.
.env*

# Arthur: NarIyirm
# 中文：本地打包结果、渲染帧与 Python 缓存可重新生成，不属于应用源码或交付素材。
# EN: Local exports, render frames, and Python caches are reproducible and do not belong in source control.
/.codex-build/
**/.frames/
**/__pycache__/
*.pyc

# Arthur: NarIyirm
# 中文：AI 产品视频的分镜、提示词、素材、样片与生成工作流仅在本地保留，避免随应用提交到 GitHub。
# EN: Keep AI product video storyboards, prompts, assets, samples, and generation workflows local instead of committing them to GitHub.
/docs/art-direction/product-video/
